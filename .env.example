# Copy to .env.local (local) or add to Replit Secrets. Never commit real values.
# All three are optional — Nexa runs fully without them.

# Optional: read CVs with Claude (model claude-opus-5-5). Without it, Nexa uses keyword matching.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: semantic skill closeness on a RunPod GPU (runpod/handler.py).
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id
